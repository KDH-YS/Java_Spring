<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.UserMapper">
    <select id="getusername" parameterType="string" resultType="com.example.demo.User">
        SELECT username, pswd FROM member WHERE username = #{username}
    </select>

<insert id="signup" parameterType="com.example.demo.User">
    INSERT INTO member (username, pswd) VALUES (#{username}, #{pswd})
</insert>


</mapper>
